# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hunar_marketplace

# Used to sign login tokens (JWTs). Any long random string works —
# changing it will log everyone out.
JWT_SECRET=change_this_to_a_long_random_string
